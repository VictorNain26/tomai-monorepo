{
  "name": "tom-monorepo",
  "private": true,
  "description": "Tom - Plateforme de tutorat socratique adaptatif",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:e2e": "node scripts/doctor.mjs --e2e",
    "dev:down": "docker compose down",
    "setup": "node scripts/setup.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:server": "turbo run dev --filter=tomai-server",
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=landing",
    "build:server": "turbo run build --filter=tomai-server",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run typecheck && pnpm run lint",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=tomai-server",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=tomai-server",
    "db:push": "turbo run db:push --filter=tomai-server",
    "db:studio": "turbo run db:studio --filter=tomai-server",
    "seed": "pnpm --filter tomai-server seed",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.14",
    "knip": "6.37.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.5.1"
}
