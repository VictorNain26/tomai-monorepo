{
  "name": "tom-monorepo",
  "private": true,
  "description": "Tom - Plateforme de tutorat socratique adaptatif",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "doctor": "bun scripts/doctor.mjs",
    "doctor:e2e": "bun scripts/doctor.mjs --e2e",
    "dev:down": "docker compose down",
    "setup": "bun scripts/setup.mjs",
    "test:scripts": "bun test ./scripts",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:server": "turbo run dev --filter=tomai-server",
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=landing",
    "build:server": "turbo run build --filter=tomai-server",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "validate": "bun run typecheck && bun run lint",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=tomai-server",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=tomai-server",
    "db:push": "turbo run db:push --filter=tomai-server",
    "db:studio": "turbo run db:studio --filter=tomai-server",
    "seed": "bun run --filter tomai-server seed",
    "eval": "bun run --cwd apps/server eval",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.14",
    "knip": "6.37.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@evilmartians/lefthook",
    "@sentry/cli",
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    }
  }
}
