{
  "name": "tom-monorepo",
  "private": true,
  "description": "Tom - Plateforme de tutorat socratique adaptatif",
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:server": "turbo run dev --filter=tomai-server",
    "dev:mobile": "turbo run dev --filter=tom-mobile",
    "dev:mobile:ios": "turbo run dev:ios --filter=tom-mobile",
    "dev:mobile:android": "turbo run dev:android --filter=tom-mobile",
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=landing",
    "build:server": "turbo run build --filter=tomai-server",
    "build:mobile": "turbo run build --filter=tom-mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run typecheck && pnpm run lint",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=tomai-server",
    "test:mobile": "turbo run test --filter=tom-mobile",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=tomai-server",
    "db:push": "turbo run db:push --filter=tomai-server",
    "db:studio": "turbo run db:studio --filter=tomai-server",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "turbo": "^2.9.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1",
      "esbuild": ">=0.25.0",
      "fast-xml-parser": ">=5.3.8",
      "rollup": ">=4.59.0",
      "tar": ">=7.5.8",
      "qs": ">=6.14.2",
      "lodash-es": ">=4.17.23",
      "@isaacs/brace-expansion": ">=5.0.1",
      "markdown-it": ">=12.3.2",
      "eslint>minimatch": ">=3.1.4",
      "eslint-plugin-react>minimatch": ">=3.1.4",
      "glob>minimatch": ">=10.2.3",
      "@typescript-eslint/typescript-estree>minimatch": ">=9.0.7",
      "eslint>ajv": ">=6.14.0 <7.0.0",
      "expo-build-properties>ajv": ">=8.18.0",
      "hono": ">=4.12.7",
      "@hono/node-server": ">=1.19.10",
      "file-type": ">=21.3.1",
      "underscore": ">=1.13.8",
      "@tootallnate/once": ">=3.0.1",
      "lodash": ">=4.17.23"
    }
  }
}
