{
  "name": "tom-monorepo",
  "private": true,
  "description": "Tom - Plateforme de tutorat socratique adaptatif",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:e2e": "node scripts/doctor.mjs --e2e",
    "dev:down": "docker compose down",
    "setup": "node scripts/setup.mjs",
    "test:scripts": "node --test scripts/",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=tomai-server",
    "dev:mobile": "turbo run dev --filter=tom-mobile",
    "dev:mobile:ios": "turbo run dev:ios --filter=tom-mobile",
    "dev:mobile:android": "turbo run dev:android --filter=tom-mobile",
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=landing",
    "build:web": "turbo run build --filter=web",
    "build:server": "turbo run build --filter=tomai-server",
    "build:mobile": "turbo run build --filter=tom-mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run typecheck && pnpm run lint",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=tomai-server",
    "test:mobile": "turbo run test --filter=tom-mobile",
    "test:py": "cd apps/curriculum && uv run pytest -q",
    "lint:py": "cd apps/curriculum && uv run ruff check . && uv run ruff format --check .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=tomai-server",
    "db:push": "turbo run db:push --filter=tomai-server",
    "db:studio": "turbo run db:studio --filter=tomai-server",
    "seed": "pnpm --filter tomai-server seed",
    "e2e:local": "node scripts/e2e-local.mjs",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.9",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.2.2"
}
