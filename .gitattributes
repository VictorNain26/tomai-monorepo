# Line-ending policy: cross-platform monorepo (Linux CI + Windows + macOS dev).
# Doc: https://git-scm.com/docs/gitattributes
#
# Goal: every text file in the index is LF, regardless of who commits from
# which OS. Eliminates the "warning: LF will be replaced by CRLF" noise on
# Windows and ensures Linux Docker builds see exactly what dev committed.

# Default: detect text vs binary, force LF for text.
* text=auto eol=lf

# ── Source code & config ────────────────────────────────────────────────
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.toml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.svg       text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.graphql   text eol=lf
*.env.example text eol=lf
.npmrc      text eol=lf
.gitignore  text eol=lf
.dockerignore text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# ── Shell scripts: must be LF (POSIX requirement) ───────────────────────
*.sh        text eol=lf
*.bash      text eol=lf

# ── Python (ai-service) ─────────────────────────────────────────────────
*.py        text eol=lf
*.pyi       text eol=lf
*.toml      text eol=lf

# ── Lock files: LF, no auto-merge (regenerate via package manager) ──────
package-lock.json text eol=lf
pnpm-lock.yaml    text eol=lf
yarn.lock         text eol=lf
uv.lock           text eol=lf

# ── Windows-only scripts: keep CRLF (cmd.exe/PowerShell parse these) ────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.vbs       text eol=crlf

# ── Binary assets: never touch ──────────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.mp3       binary
*.mp4       binary
*.wav       binary
*.zip       binary
*.tar       binary
*.gz       binary
*.tgz       binary
*.7z       binary
*.exe       binary
*.dll       binary
*.so       binary
*.dylib    binary
*.node      binary
*.wasm      binary
