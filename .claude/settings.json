{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",

  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },

  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(.env.backup)",
      "Read(.env.bak)",
      "Read(.env.old)",
      "Read(.env.orig)",
      "Read(.env.save)",
      "Read(.env.keys)",
      "Read(.env.prod)",
      "Read(.env.dev)",
      "Read(.env.ci)",
      "Read(.env.secret)",
      "Read(.env.secrets)",

      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-db.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-typescript-edit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-validation-before-stop.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
