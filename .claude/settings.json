{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",

  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },

  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",

      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(*db:push*)",
      "Bash(drizzle-kit push*)",
      "Bash(* drizzle-kit push*)",

      "Bash(dropdb *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(docker compose down -v*)"
    ]
  }
}
