{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/*.pem)"
    ],
    "ask": [
      "Bash(drizzle-kit push*)",
      "Bash(* drizzle-kit push*)",
      "Bash(*drizzle-kit drop*)",
      "Bash(dropdb *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(*TRUNCATE*)",
      "Bash(*truncate table*)",
      "Bash(*docker compose down -v*)",
      "Bash(*docker compose down --volumes*)",
      "Bash(*docker volume rm*)"
    ]
  }
}
