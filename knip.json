{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/server": {
      "entry": [
        "src/index.ts",
        "src/app.ts",
        "src/db/migrate.ts",
        "drizzle.config.ts",
        "scripts/**/*.ts",
        "src/tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["proxy.ts"],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "proxy.ts"
      ],
      "ignoreDependencies": ["tailwindcss", "@repo/tokens"]
    },
    "apps/mobile": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "__mocks__/**/*.{ts,tsx}",
        "scripts/**/*.{ts,js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js}"],
      "ignoreDependencies": ["react-native-pager-view", "@babel/core", "@babel/generator"]
    },
    "packages/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/tokens": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
