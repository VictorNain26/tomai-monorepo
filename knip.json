{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreBinaries": ["uv", "eslint"]
    },
    "apps/server": {
      "entry": ["src/app.ts", "scripts/**/*.ts", "src/tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/mobile": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "__mocks__/**/*.{ts,tsx}",
        "scripts/**/*.{ts,js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js,mjs}"],
      "ignoreDependencies": ["@babel/generator"],
      "ignoreBinaries": ["eas"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    "packages/tokens": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
