{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/tokens": {
      "entry": ["*.test.mjs"]
    },
    "tooling/playwright-web": {
      "entry": ["reset-database.ts"],
      "ignoreDependencies": ["tomai-server", "web"]
    }
  }
}
