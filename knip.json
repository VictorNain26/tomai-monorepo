{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ],
      "ignoreBinaries": [
        "eslint"
      ]
    },
    "apps/server": {
      "entry": [
        "src/app.ts",
        "scripts/**/*.ts",
        "src/tests/**/*.test.ts",
        "src/integration-tests/**/*.test.ts",
        "src/live/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ],
      "ignoreBinaries": [
        "dist/index.js"
      ]
    },
    "packages/api": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/tokens": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/ui": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}