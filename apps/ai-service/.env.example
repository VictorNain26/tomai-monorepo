# =============================================================================
# tomai-ai-service — variables d'environnement
# Copier vers apps/ai-service/.env (gitignoré) et remplir.
# Périmètre du service : docs/adr/0002-ai-service-scope.md
# =============================================================================

# EMBED_MODEL — [dev] optionnel, défaut "BAAI/bge-m3" (src/config.py).
EMBED_MODEL=BAAI/bge-m3

# USE_FP16 — [dev] optionnel, défaut "false". Opt-in explicite, jamais de
# détection auto : sur CPU le comportement doit être déterministe.
#
# Mesuré le 2026-08-21 : le service consomme **1,15 Gio en FP32** sous charge
# d'ingestion — soit 2,6× moins que les ~3 Go annoncés jusqu'ici. Le FP16
# n'est donc PAS nécessaire pour tenir dans une instance 2 Go.
USE_FP16=false

# HF_HOME — [dev] optionnel, défaut "/data/hf_cache". Cache des modèles
# HuggingFace (~2,4 Go téléchargés au premier démarrage).
HF_HOME=/data/hf_cache

# ENVIRONMENT — [dev] optionnel, défaut "development". "production" active le
# fail-fast au boot sur API_TOKEN manquant (src/config.py:validate_config).
ENVIRONMENT=development

# API_TOKEN — [auto] optionnel en dev, OBLIGATOIRE en production (le service
# refuse de démarrer sans). Protège /embed via "Authorization: Bearer <token>",
# comparaison constant-time.
# Doit être IDENTIQUE à AI_SERVICE_TOKEN côté apps/server et apps/curriculum.
# Générer : openssl rand -hex 32
API_TOKEN=

# PORT — [dev] optionnel, défaut 8000. Injecté par la plateforme en production.
# En dev le conteneur mappe 8001 (hôte) → 8000 (conteneur).
PORT=8000

# SENTRY_DSN — [externe] optionnel. Absent (dev, CI) = aucune initialisation,
# aucun appel réseau, rien ne casse. Présent = Sentry armé au boot avec
# send_default_pii=false.
# Le service ne reçoit jamais d'identité utilisateur (ADR 0002) et le texte
# embeddé n'est attaché à aucun signal — il n'y a donc rien à masquer.
# Projet Sentry dédié recommandé plutôt que celui du serveur : volumes, quotas
# et destinataires d'alerte différents.
SENTRY_DSN=
