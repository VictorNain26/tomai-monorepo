# EMBED_MODEL — [dev] optionnel, défaut "BAAI/bge-m3" (src/config.py:14).
EMBED_MODEL=BAAI/bge-m3

# USE_FP16 — [dev] optionnel, défaut "false". "true" = ~2x moins de RAM,
# perte de recall négligeable (src/config.py:19).
USE_FP16=false

# HF_HOME — [dev] optionnel, défaut "/data/hf_cache". Chemin du cache des
# modèles HuggingFace téléchargés (src/config.py:23).
HF_HOME=/data/hf_cache

# ENVIRONMENT — [dev] optionnel, défaut "development". "production" active
# le fail-fast sur API_TOKEN manquant (src/config.py:27).
ENVIRONMENT=development

# API_TOKEN — [externe] optionnel en dev, OBLIGATOIRE en production
# (fail-fast si ENVIRONMENT=production). Protège /embed via
# "Authorization: Bearer <token>" (src/config.py:32).
API_TOKEN=

# PORT — [dev] optionnel, défaut 8000. Injecté par la plateforme en
# production (Koyeb) (src/config.py:35).
PORT=8000
