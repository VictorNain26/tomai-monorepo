# =============================================================================
# apps/curriculum — pipeline d'ingestion RAG (app Python autonome)
# Copier vers apps/curriculum/.env (gitignoré) et remplir.
# =============================================================================

# MISTRAL_API_KEY — [externe] utilisé UNIQUEMENT pour l'authoring du golden set
# (scripts/generate_golden.py). L'ingestion et l'évaluation n'en ont pas besoin.
MISTRAL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant Cloud EU — l'index est la source unique de vérité (dev ET prod)
# ─────────────────────────────────────────────────────────────────────────────
# MÊME cluster et MÊME collection que `apps/server/.env`, sinon le backend
# interroge une collection que ce pipeline n'a pas peuplée.
# Le client exige une clé dès que l'URL est en https.
QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=tomai_educational

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings denses — OVHcloud AI Endpoints (Gravelines)
# ─────────────────────────────────────────────────────────────────────────────
# Le vecteur creux n'est PAS produit ici : Qdrant le calcule côté serveur
# (Cloud Inference, modèle `bm25`, gratuit et illimité). Aucun modèle à héberger.
# Générer la clé : console OVHcloud → Public Cloud → AI Endpoints → Clés API.
# Le projet doit être ACTIVÉ (moyen de paiement) — en mode « Découverte » la
# clé est émise mais refusée avec « not allowed ... on any tenant ».
OVH_AI_ENDPOINTS_TOKEN=

# Doit correspondre au modèle ET à la dimension qui ont construit l'index :
# une requête vectorisée autrement cherche dans un autre espace, silencieusement.
OVH_EMBED_MODEL=Qwen3-Embedding-8B

# Matryoshka (MRL) : le modèle rend 4096D nativement, OVH tronque et renormalise
# côté serveur. Bornes documentées : 32 à 4096 (HTTP 400 au-delà).
OVH_EMBED_DIMENSIONS=1024

# OVH_EMBED_BATCH_SIZE — plafond DUR côté OVH : 25 entrées par requête
# (au-delà : HTTP 400 « given batch size overflow maximal one »).
OVH_EMBED_BATCH_SIZE=25

# ─────────────────────────────────────────────────────────────────────────────
# Légifrance PISTE — veille des réformes, REQUIS
# ─────────────────────────────────────────────────────────────────────────────
# C'est la seule voie vers le texte des arrêtés : education.gouv.fr, eduscol et
# legifrance renvoient 403 sur tout HTML. Sans ces clés, la veille ne peut pas
# conclure — et son silence a laissé passer les réformes 2024, 2025 et 2026.
#
# Les créer : compte sur https://piste.gouv.fr/registration → APPLICATIONS →
# « Créer une application » → « Générer » un ID OAuth → « Consentement CGU API »
# pour Légifrance → souscription sur le canal PRODUCTION.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
