# Copier en .env et remplir les valeurs
# Ne jamais committer .env

# Mistral (EU-souverain, api.mistral.ai) — authoring du golden set uniquement
MISTRAL_API_KEY=your-mistral-api-key

# Qdrant Cloud EU — index = source unique de vérité.
# MÊME cluster + MÊME collection que le serveur (apps/server/.env), sinon le
# backend interroge une collection que ce pipeline n'a pas peuplée.
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=tomai_educational

# ai-service (embeddings BGE-M3 dense+sparse) — local en dev, ou déploiement Koyeb
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=
# EMBED_BATCH_SIZE=16   # si l'ai-service tourne sur CPU peu de cœurs (évite le timeout /embed)

# Legifrance PISTE (veille programmes, optionnel)
PISTE_CLIENT_ID=your-piste-client-id
PISTE_CLIENT_SECRET=your-piste-client-secret
