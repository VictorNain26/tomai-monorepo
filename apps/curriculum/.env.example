# =============================================================================
# apps/curriculum — pipeline d'ingestion RAG (app Python autonome)
# Copier vers apps/curriculum/.env (gitignoré) et remplir.
# =============================================================================

# MISTRAL_API_KEY — [externe] utilisé UNIQUEMENT pour l'authoring du golden set
# (scripts/generate_golden.py). L'ingestion et l'évaluation n'en ont pas besoin.
MISTRAL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant Cloud EU — l'index est la source unique de vérité (dev ET prod)
# ─────────────────────────────────────────────────────────────────────────────
# MÊME cluster et MÊME collection que `apps/server/.env`, sinon le backend
# interroge une collection que ce pipeline n'a pas peuplée.
# Le client exige une clé dès que l'URL est en https.
QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=tomai_educational

# ─────────────────────────────────────────────────────────────────────────────
# ai-service — embeddings BGE-M3 dense + sparse
# ─────────────────────────────────────────────────────────────────────────────
# Local en dev (le conteneur mappe 8001 → 8000), ou le déploiement Koyeb.
AI_SERVICE_URL=http://localhost:8001
# Doit être identique à API_TOKEN côté ai-service. Vide = conteneur local sans auth.
AI_SERVICE_TOKEN=

# EMBED_BATCH_SIZE — nombre de textes par appel /embed. Défaut 200.
# Le client a un timeout de 300 s (src/clients/ai_service.py). Mesuré le
# 2026-08-21 sur CPU : un chunk de ~1 600 caractères prend ~3 s à embedder,
# donc un lot de 200 dépasserait très largement le timeout.
# **Utiliser 16 pour toute ingestion sur CPU.**
EMBED_BATCH_SIZE=16

# ─────────────────────────────────────────────────────────────────────────────
# Légifrance PISTE — veille des programmes, entièrement optionnel
# ─────────────────────────────────────────────────────────────────────────────
# Absent = la veille saute la partie Légifrance sans échouer (best-effort
# intentionnel, cf. CLAUDE.md de l'app).
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
