# =============================================================================
# tomai-landing (Next.js) — variables d'environnement
# Copier vers apps/landing/.env.local (gitignoré) et remplir.
#
# `NEXT_PUBLIC_*` est inliné dans le bundle client : jamais de secret ici.
# =============================================================================

# NEXT_PUBLIC_SERVER_URL — [dev] optionnel, défaut http://localhost:3000
# (lib/urls.ts). En production, pointer vers le serveur Koyeb (ex:
# https://api.tomia.fr).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# NEXT_PUBLIC_SENTRY_DSN — [externe] optionnel. Sans DSN, `Sentry.init` est un
# no-op dans les trois runtimes (instrumentation-client.ts,
# sentry.server.config.ts, sentry.edge.config.ts).
# En production : posé dans Vercel (org home-drx, région EU, projet
# tomai-landing).
NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN — [externe] build-only, jamais lu au runtime. Sert
# uniquement à l'upload des sourcemaps (next.config.mjs). Absent en local et en
# CI = upload silencieusement ignoré, le build passe.
# Posé dans Vercel, jamais dans un fichier commité.
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Injectées par la plateforme — ne rien poser à la main
#   VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV : environnement de déploiement Vercel
#   NEXT_RUNTIME                       : 'nodejs' | 'edge', posée par Next.js
#   CI                                 : posée par le runner CI
# ─────────────────────────────────────────────────────────────────────────────
