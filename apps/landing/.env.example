# NEXT_PUBLIC_SERVER_URL — [dev] optionnel, défaut http://localhost:3000 (lib/urls.ts:12).
# En production, pointer vers l'URL du serveur Koyeb (ex: https://api.tomia.fr).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# NEXT_PUBLIC_SENTRY_DSN — [dev] optionnel ; sans DSN, Sentry.init est un
# no-op (instrumentation-client.ts / sentry.server.config.ts / sentry.edge.config.ts).
# En production, valeur posée dans Vercel (org home-drx, région EU, projet tomai-landing).
NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN — build-only, jamais utilisé au runtime. Nécessaire
# uniquement pour l'upload des sourcemaps (silencieux et sans effet si absent
# en local/CI). Posé dans Vercel, jamais dans un .env local commité.
SENTRY_AUTH_TOKEN=
