# =============================================================================
# TomAI server — environment. Copy to apps/server/.env (`bun run setup` does it).
# The schema, with every default and check: src/config.ts.
# =============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Requests per minute a client address may send to the API.
# API_RATE_LIMIT=100

# The Postgres of `docker compose`. The tests use the same server: each file gets its own
# database, so the user must be allowed to create databases (the compose one is).
DATABASE_URL=postgresql://tomai_dev:tomai_dev_password@localhost:5432/tomai_dev

# At least 32 characters; `bun run setup` generates it (or: openssl rand -base64 32).
BETTER_AUTH_SECRET=
# The one public origin of the API and the web. In dev, the Vite dev server, whose proxy
# forwards /api and /health here; in production, required.
BETTER_AUTH_URL=http://localhost:3002

# The build of apps/web, served on that origin. Required in production (the image sets it);
# in dev, Vite serves the web.
# WEB_DIST_DIR=../web/dist

# Scaleway Transactional Email (docs/etudes/2026-10-07/email-transactionnel.md): an IAM key
# restricted to it, its Project, and a sender on the Project's checked domain. All four or none;
# required in production. Without them, the emails (verification, reset, deletion) are logged.
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_PROJECT_ID=
# MAIL_FROM=

# Mistral (.claude/skills/mistral-stack). The key is required in production; without it, Mistral
# refuses the tutor's calls. The endpoint defaults to the EU one, which production requires; the
# model is a dated one, never a -latest alias.
MISTRAL_API_KEY=
# MISTRAL_SERVER_URL=https://api.eu.mistral.ai
# MISTRAL_MODEL=mistral-small-2603
# MISTRAL_TIMEOUT_MS=30000
# MISTRAL_RETRY_ATTEMPTS=2
