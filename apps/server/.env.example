# =============================================================================
# TomAI Server — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Core
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://tomai_dev:tomai_dev_password@localhost:5432/tomai_dev

# CORS
CORS_ORIGINS=http://localhost:3001

# =============================================================================
# AI — Mistral 100% (chat + embeddings + STT + TTS + OCR, souveraineté EU)
# =============================================================================
MISTRAL_API_KEY=

# Optional model overrides (defaults are sensible for production).
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_REASONING_MODEL=magistral-medium-latest
# MISTRAL_AUX_MODEL=mistral-small-latest
# MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-transcribe-latest
# MISTRAL_TTS_MODEL=voxtral-tts-latest
# MISTRAL_TEMPERATURE=0.7
# MISTRAL_MAX_TOKENS=16384
# MISTRAL_TIMEOUT=60000

# Voxtral TTS voice ids (created via `bun run scripts/voxtral-create-voices.ts`).
# Required for spoken responses; the service errors at synthesis time if unset.
VOXTRAL_VOICE_PRIMAIRE=
VOXTRAL_VOICE_COLLEGE=
VOXTRAL_VOICE_LYCEE=
# VOXTRAL_VOICE_DEFAULT=

# =============================================================================
# RAG — Qdrant Cloud
# =============================================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tomai_educational

# =============================================================================
# Authentication (Better Auth + Google OAuth)
# =============================================================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Payments — RevenueCat (mobile IAP, single source of subscription truth)
# =============================================================================
# Webhook authorization (≥32 chars, timing-safe comparison).
REVENUECAT_WEBHOOK_AUTH=

# =============================================================================
# File Storage — Scaleway Object Storage (RGPD, fr-par)
# =============================================================================
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_BUCKET=
SCALEWAY_REGION=fr-par

# =============================================================================
# Pronote Integration (optional)
# =============================================================================
# AES-256-GCM master key (generate with: openssl rand -base64 48)
PRONOTE_ENCRYPTION_KEY=
