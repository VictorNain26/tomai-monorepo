# =============================================================================
# TomAI Server — Environment Variables
# Copy to apps/server/.env and fill in. The server reads this at boot (env.ts).
#
# Legend:
#   [dev]      sensible default for local dev — keep as-is
#   [auto]     secret you generate yourself (command given) — no account needed
#   [externe]  real key from a provider account — needed to test that feature
#
# Email auth + RAG infra work with zero [externe] keys. Each feature stays
# "degraded" until its var is filled — the env is intentionally incremental.
# =============================================================================

# =============================================================================
# Core
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# =============================================================================
# Database (PostgreSQL + pgvector) — [dev] matches `docker compose` postgres
# =============================================================================
DATABASE_URL=postgresql://tomai_dev:tomai_dev_password@localhost:5432/tomai_dev
DATABASE_URL_EXTERNAL=postgresql://tomai_dev:tomai_dev_password@localhost:5432/tomai_dev

# =============================================================================
# CORS — [dev] landing:3001
# =============================================================================
CORS_ORIGINS=http://localhost:3001

# =============================================================================
# Authentication (Better Auth)
# =============================================================================
# [auto] required to boot (>=32 chars). `pnpm setup` fills this automatically.
#        Manual: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# [externe] Google OAuth login — https://console.cloud.google.com/apis/credentials
#           Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# AI tutor — Mistral (sovereign EU: chat, vision, OCR, TTS, episodic memory)
# =============================================================================
# [externe] CORE feature — https://console.mistral.ai/api-keys
#           Without it the server boots "degraded" and chat / card-gen fail at use.
MISTRAL_API_KEY=

# =============================================================================
# RAG — ai-service (BGE-M3 embeddings) + Qdrant   [dev] Cloud = source unique de vérité
# =============================================================================
AI_SERVICE_URL=http://localhost:8001
# [dev] Timeout d'un appel /embed. 8 s couvre largement une query courte
#       (~600 ms mesuré sur 2 vCPU) ; à augmenter seulement si le service est
#       distant et lent.
AI_SERVICE_TIMEOUT_MS=8000
# [auto] In dev the ai-service container runs public, so any non-empty value
#        works (and pnpm doctor requires it non-empty). To enforce real auth,
#        set the SAME value in a root .env (AI_SERVICE_TOKEN=) and recreate the
#        ai-service container. Manual: openssl rand -hex 32
AI_SERVICE_TOKEN=dev-local-token
# [externe] L'index curriculum vit sur Qdrant Cloud (partagé dev + prod, déjà
#           ingéré). URL + clé auprès de l'équipe. Cloud (https) exige la clé ;
#           le code n'embarque AUCUN nom de collection en dur (config d'env).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
# [dev] MUST be true to enable RAG server-side (default in code is false).
QDRANT_ENABLED=true
#
# Offline (sans Cloud) : Qdrant local keyless + ingestion locale. Voir
# apps/curriculum/README.md. Décommenter :
#   QDRANT_URL=http://localhost:6333
#   QDRANT_COLLECTION=tomai_educational

# =============================================================================
# Voice — Gladia (Speech-to-Text, EU/Paris)
# =============================================================================
# [externe] voice input — https://app.gladia.io/
GLADIA_API_KEY=

# =============================================================================
# File storage — Scaleway Object Storage (uploads + multimodal photos/PDF, RGPD fr)
# =============================================================================
# [externe] uploads — API keys: https://console.scaleway.com/iam/api-keys
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
# bucket: https://console.scaleway.com/object-storage/buckets
SCALEWAY_BUCKET=
# fr-par (Paris) | nl-ams (Amsterdam) | pl-waw (Warsaw)
SCALEWAY_REGION=fr-par

# =============================================================================
# Payments — RevenueCat webhooks
# =============================================================================
# [auto] shared secret for webhook auth (>=32 chars). Manual: openssl rand -hex 32
#        Must match the webhook secret set in https://app.revenuecat.com/
REVENUECAT_WEBHOOK_AUTH=

# =============================================================================
# Pronote integration
# =============================================================================
# [auto] AES-256-GCM key for Pronote tokens (>=32 chars). Manual: openssl rand -base64 48
PRONOTE_ENCRYPTION_KEY=

# Pronote e2e test account (TEST-ONLY — never used by prod code). Fill in apps/server/.env (gitignored).
# PRONOTE_TEST_URL=https://XXXXXXXX.index-education.net/pronote/
# PRONOTE_TEST_USERNAME=
# PRONOTE_TEST_PASSWORD=
# PRONOTE_TEST_KIND=7   # 6=student, 7=parent, 8=teacher

# =============================================================================
# Modèles Mistral — un emplacement par usage
# =============================================================================
# Tous ont un défaut dans le code (env.ts) : à ne renseigner que pour dévier.
# Listés ici pour que le casting soit visible d'un coup d'œil.
#
# /!\ ministral-8b-latest et ministral-3b-latest pointent sur des références
#     RETIREES le 31/12/2025 (remplacees par Ministral 3 8B / 3B). Et la doc de
#     cycle de vie Mistral deconseille les alias `-latest` en production
#     (« changements silencieux de comportement et de tarification » ;
#     recommandation : pinner en major.minor).
#     Chantier « casting des modeles » ouvert — cf. docs/audits/2026-08-21.
#
# MISTRAL_MODEL=mistral-medium-latest          # chat principal (vision incluse)
# MISTRAL_MODEL_CLASSIFY=ministral-8b-latest   # classification d'intention
# MISTRAL_MODEL_TITLE=ministral-3b-latest      # auto-titrage de session
# MISTRAL_MODEL_LIGHT=mistral-small-latest     # resumes, generation de cartes
# MISTRAL_EMBED_MODEL=mistral-embed            # memoire episodique (pgvector)
# MISTRAL_STT_MODEL=voxtral-mini-latest        # transcription
# MISTRAL_TTS_MODEL=voxtral-tts-latest         # synthese vocale
# MISTRAL_MAX_TOKENS=16384
# MISTRAL_TEMPERATURE=0.7
# MISTRAL_TIMEOUT=60000
# MISTRAL_RETRY_ATTEMPTS=3
# CHAT_STREAM_TIMEOUT_MS=120000

# =============================================================================
# Observabilite
# =============================================================================
# [externe] Sentry — remontee d'erreurs. Absent = aucune initialisation, rien
#           ne casse. Region EU.
SENTRY_DSN=

# [externe] Destination OTLP des traces. Le serveur emet DEJA des spans GenAI
#           (semconv) via src/lib/otel/ : aucun code a ecrire, seulement ces
#           deux variables.
#           Langfuse Cloud EU — projet `tomai` deja cree :
#             OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
#             OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>
#           Fabriquer le base64 :
#             printf '%s' "pk-lf-XXX:sk-lf-YYY" | base64 -w0
#           /!\ Avant de brancher : verifier ce que les spans du serveur
#               transportent — un prompt d'eleve ne doit pas partir vers un
#               service tiers.
#           Vide = export console en dev, rien en production.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# [externe] PostHog — non installe a ce jour (chantier separe).
POSTHOG_API_KEY=

# [dev] Identite du build, remontee par /health et les traces.
# APP_VERSION=1.0.0
# GIT_COMMIT_SHA=unknown
# DEPLOYMENT_ID=
# DEBUG=

# =============================================================================
# Sessions, quotas et limites — defauts du code, a changer sciemment seulement
# =============================================================================
# FRONTEND_URL=
# TRUSTED_ORIGINS=
# SESSION_MAX_AGE=604800            # 7 jours
# SESSION_UPDATE_AGE=86400          # 1 jour
# RATE_LIMIT_WINDOW_MS=900000       # 15 min
# RATE_LIMIT_MAX_REQUESTS_API=100
# RATE_LIMIT_MAX_REQUESTS_CHAT=10
# QUOTA_ENFORCEMENT_ENABLED=true
# USD_TO_EUR_RATE=0.92
