{
  "name": "tomai-server",
  "version": "2.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --hot src/index.ts",
    "dev:memory": "bun --watch --hot --smol src/index.ts",
    "start:prod": "bun --smol dist/index.js",
    "build": "bun run build:server && bun run build:migrate",
    "build:server": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap=linked --format esm",
    "build:migrate": "bun build src/db/migrate.ts --outdir dist --target bun --sourcemap=linked --format esm",
    "build:validated": "bun run validate:prod && bun run build",
    "build:koyeb": "bun run typecheck:strict && bun run lint:ci && bun run build",
    "start": "bun dist/index.js",
    "typecheck": "bun --bun tsc --noEmit",
    "typecheck:strict": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint src",
    "lint:fix": "bun --bun eslint src --fix",
    "lint:ci": "bun --bun eslint src --max-warnings 0",
    "test": "bun run scripts/run-tests.ts",
    "test:fast": "bun test src/tests/",
    "test:integration": "bun test src/integration-tests/",
    "test:watch": "bun test src/tests/ --watch",
    "test:coverage": "bun run scripts/run-tests.ts --coverage",
    "validate": "bun run typecheck:strict && bun run lint",
    "validate:ci": "bun run typecheck:strict && bun run lint:ci",
    "validate:prod": "bun run typecheck:strict && bun run lint:ci",
    "clean": "rm -rf dist bun.lockb node_modules/.cache",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bun --bun drizzle-kit push --config=drizzle.config.ts --force",
    "db:studio": "bunx drizzle-kit studio",
    "db:check": "bun --bun drizzle-kit check",
    "db:pull": "bun --bun drizzle-kit pull --config=drizzle.config.ts",
    "db:health": "bun -e \"import('./src/db/connection.js').then(m => m.healthCheck()).then(console.log)\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend",
    "docker:dev": "docker compose up -d postgres && bun run dev",
    "docker:studio": "docker compose --profile tools up drizzle-studio",
    "docker:build": "docker build -t tomai-backend:latest .",
    "docker:clean": "docker compose down -v && docker system prune -af",
    "docker:restart": "docker compose down && docker compose up -d",
    "rag:cache:invalidate": "bun run src/scripts/invalidate-cache.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@better-auth/expo": "^1.6.11",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@mistralai/mistralai": "^1.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@qdrant/js-client-rest": "^1.16.2",
    "@repo/shared-types": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.27",
    "glob": "^13.0.6",
    "mammoth": "^1.11.0",
    "p-limit": "^7.1.1",
    "pgvector": "^0.2.1",
    "postgres": "^3.4.7",
    "ts-fsrs": "^5.2.3",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.8",
    "eslint": "catalog:",
    "globals": "^16.5.0",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "better-auth",
    "@better-auth/cli",
    "drizzle-kit"
  ]
}
