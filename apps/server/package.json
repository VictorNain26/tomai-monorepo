{
  "name": "tomai-server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts | pino-pretty",
    "start": "bun dist/main.js",
    "build": "bun build src/main.ts src/migrate.ts --outdir dist --target bun --minify --sourcemap=linked --format esm",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun test",
    "clean": "rm -rf dist",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun src/migrate.ts",
    "db:check": "bun --bun drizzle-kit check --config=drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio",
    "referential:extract": "bun src/referential/extract.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@hono/bun": "^1.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "11.2.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "pino-pretty": "^13.1.3",
    "typescript": "6.0.3"
  }
}
