{
  "name": "tomai-server",
  "version": "2.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/types/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/app.d.ts",
      "import": "./src/index.ts"
    },
    "./app": {
      "types": "./dist/types/app.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --hot src/index.ts",
    "build": "bun run build:server && bun run build:migrate",
    "build:types": "bun --bun tsc -p tsconfig.build.types.json",
    "build:server": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap=linked --format esm",
    "build:migrate": "bun build src/platform/db/migrate.ts --outdir dist --target bun --sourcemap=linked --format esm",
    "start": "bun dist/index.js",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint src scripts --max-warnings 0",
    "lint:fix": "bun --bun eslint src --fix",
    "test": "bun run scripts/run-tests.ts src/tests",
    "test:integration": "bun run scripts/run-tests.ts src/integration-tests --jobs=1",
    "test:live": "bun run scripts/run-tests.ts src/live --jobs=1",
    "clean": "rm -rf dist",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun run src/platform/db/migrate.ts",
    "db:push": "bun --bun drizzle-kit push --config=drizzle.config.ts --force",
    "db:studio": "bunx drizzle-kit studio",
    "db:check": "bun --bun drizzle-kit check",
    "seed": "bun run src/scripts/seed-dev.ts",
    "referential:extract": "bun src/referential/extract.ts",
    "eval": "NODE_ENV=test QUOTA_ENFORCEMENT_ENABLED=false LOG_LEVEL=warn bun src/eval/run.ts",
    "eval:annotate": "bun src/eval/annotate.ts",
    "eval:agreement": "NODE_ENV=test LOG_LEVEL=warn bun src/eval/measure-agreement.ts",
    "eval:cases": "NODE_ENV=test LOG_LEVEL=warn bun src/eval/run-cases.ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.48",
    "@ai-sdk/otel": "1.0.107",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@date-fns/tz": "^1.5.0",
    "@hono/bun": "^1.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@mistralai/mistralai": "^2.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/bun": "11.1.0",
    "@sentry/hono": "11.1.0",
    "ai": "^7.0.107",
    "better-auth": "^1.7.5",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "mammoth": "^1.12.3",
    "mathjs": "^15.2.0",
    "p-map": "^7.0.8",
    "p-throttle": "^8.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.1",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "6.0.3"
  }
}
