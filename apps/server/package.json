{
  "name": "tomai-server",
  "version": "2.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/types/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/app.d.ts",
      "import": "./src/index.ts"
    },
    "./app": {
      "types": "./dist/types/app.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --hot src/index.ts",
    "dev:memory": "bun --watch --hot --smol src/index.ts",
    "start:prod": "bun --smol dist/index.js",
    "build": "bun run build:server && bun run build:migrate",
    "build:types": "bun --bun tsc -p tsconfig.build.types.json",
    "build:server": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap=linked --format esm",
    "build:migrate": "bun build src/db/migrate.ts --outdir dist --target bun --sourcemap=linked --format esm",
    "build:validated": "bun run validate:prod && bun run build",
    "build:koyeb": "bun run typecheck:strict && bun run lint:ci && bun run build",
    "start": "bun dist/index.js",
    "typecheck": "bun --bun tsc --noEmit",
    "typecheck:strict": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint src",
    "lint:fix": "bun --bun eslint src --fix",
    "lint:ci": "bun --bun eslint src --max-warnings 0",
    "test": "bun run scripts/run-tests.ts",
    "test:fast": "bun test src/tests/",
    "test:integration": "bun run scripts/run-tests.ts src/integration-tests",
    "test:live": "bun run scripts/run-tests.ts src/live",
    "test:watch": "bun test src/tests/ --watch",
    "test:coverage": "bun run scripts/run-tests.ts --coverage",
    "validate": "bun run typecheck:strict && bun run lint",
    "validate:ci": "bun run typecheck:strict && bun run lint:ci",
    "validate:prod": "bun run typecheck:strict && bun run lint:ci",
    "clean": "rm -rf dist bun.lockb node_modules/.cache",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bun --bun drizzle-kit push --config=drizzle.config.ts --force",
    "db:studio": "bunx drizzle-kit studio",
    "db:check": "bun --bun drizzle-kit check",
    "db:pull": "bun --bun drizzle-kit pull --config=drizzle.config.ts",
    "db:health": "bun -e \"import('./src/db/connection.js').then(m => m.healthCheck()).then(console.log)\"",
    "seed": "bun run src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.48",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@mistralai/mistralai": "^2.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/elysia": "10.75.0",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.107",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "mammoth": "^1.12.3",
    "p-limit": "^7.3.3",
    "pawnote": "^1.6.2",
    "postgres": "^3.4.9",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "globals": "^17.12.0",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "better-auth",
    "@better-auth/cli",
    "drizzle-kit"
  ]
}
