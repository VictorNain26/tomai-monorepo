{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* ===================================== */
    /* SERVER BASE - BUN RUNTIME 2026       */
    /* Extends monorepo base config         */
    /* ===================================== */

    /* Bun Environment */
    "types": ["bun-types"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",

    /* Path Mapping — TS 6.0 requires relative paths (no baseUrl).
       https://devblogs.microsoft.com/typescript/announcing-typescript-6-0/ */
    "paths": {
      "@/*": ["./src/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/services/*": ["./src/services/*"],
      "@/middleware/*": ["./src/middleware/*"],
      "@/types/*": ["./src/types/*"],
      "@/config/*": ["./src/config/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  }
}
