{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* ========================================================= */
    /* SERVER — PUBLIC API TYPE EMIT                             */
    /* Emits the `App` route-tree type (+ its referenced types)  */
    /* to dist/types so clients consume a built .d.ts instead of */
    /* type-checking the Bun-flavoured server source.            */
    /* ========================================================= */
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/types/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/tests/**",
    "src/scripts/archive/**/*"
  ]
}
