{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && find dist -type f \\( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.webmanifest' \\) -exec gzip -9 -k -n {} +",
    "preview": "vite preview --port 3002 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "bun test src",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@repo/tokens": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "^1.7.5",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "bun-types": "^1.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "tomai-server": "workspace:*",
    "typescript": "6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
