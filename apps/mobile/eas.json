{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_NO_FINGERPRINT_VALIDATION": "1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://api-staging.tomia.fr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "294154280388-4a5pnm5b4qpgh69btual0ld1ietvfakl.apps.googleusercontent.com"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://api-staging.tomia.fr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "294154280388-4a5pnm5b4qpgh69btual0ld1ietvfakl.apps.googleusercontent.com"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.tomia.fr",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "294154280388-4a5pnm5b4qpgh69btual0ld1ietvfakl.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
