{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* React Native specific */
    "jsx": "react-native",
    "lib": ["ES2024"],
    "types": ["jest", "@testing-library/react-native", "node", "bun-types"],

    /* Path Mapping (TS 5+ bundler mode : paths résolus relativement au tsconfig
     * sans baseUrl, déprécié en TS 6.x). Babel résout via babel-plugin-module-
     * resolver côté Metro (config dans babel.config.js, indépendant de baseUrl). */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "global-css.d.ts"
  ],
  "exclude": ["node_modules", ".expo", "babel.config.js", "metro.config.js"]
}
