{
  "name": "tom-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "expo start --tunnel",
    "dev:client": "expo start --dev-client",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "dev:web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:safe": "node scripts/safe-build.js",
    "build:safe:preview": "node scripts/safe-build.js preview android",
    "build:safe:prod": "node scripts/safe-build.js production android",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "workflow:preview:android": "eas workflow:run .eas/workflows/preview-android.yml",
    "workflow:preview:ios": "eas workflow:run .eas/workflows/preview-ios.yml",
    "workflow:prod:android": "eas workflow:run .eas/workflows/production-android.yml",
    "workflow:prod:ios": "eas workflow:run .eas/workflows/production-ios.yml",
    "fingerprint": "eas fingerprint:generate",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update:dev": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:prod": "eas update --channel production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.10",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.26",
    "@repo/api": "workspace:*",
    "@rn-primitives/portal": "^1.1.3",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/types": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.90.12",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-persist-client": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.31",
    "expo-audio": "*",
    "expo-background-task": "*",
    "expo-build-properties": "*",
    "expo-camera": "*",
    "expo-constants": "*",
    "expo-dev-client": "*",
    "expo-device": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-image-picker": "*",
    "expo-linear-gradient": "*",
    "expo-linking": "*",
    "expo-network": "*",
    "expo-notifications": "*",
    "expo-router": "*",
    "expo-secure-store": "*",
    "expo-sharing": "*",
    "expo-splash-screen": "*",
    "expo-sqlite": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo-task-manager": "*",
    "expo-updates": "*",
    "expo-web-browser": "*",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "pawnote": "^1.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.6.14",
    "react-native-purchases-ui": "^9.6.14",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.15.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@repo/eslint-config": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.28.0",
    "jest-expo": "^54.0.16",
    "postcss": "^8.5.3",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:"
  }
}
