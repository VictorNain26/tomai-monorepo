{
  "name": "tom-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "expo start --tunnel",
    "dev:client": "expo start --dev-client",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "dev:web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:safe": "node scripts/safe-build.js",
    "build:safe:preview": "node scripts/safe-build.js preview android",
    "build:safe:prod": "node scripts/safe-build.js production android",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "workflow:preview:android": "eas workflow:run .eas/workflows/preview-android.yml",
    "workflow:preview:ios": "eas workflow:run .eas/workflows/preview-ios.yml",
    "workflow:prod:android": "eas workflow:run .eas/workflows/production-android.yml",
    "workflow:prod:ios": "eas workflow:run .eas/workflows/production-ios.yml",
    "fingerprint": "eas fingerprint:generate",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update:dev": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:prod": "eas update --channel production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@better-auth/passkey": "^1.5.4",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-google-signin/google-signin": "^14.0.2",
    "@react-navigation/native": "^7.1.28",
    "@repo/api": "workspace:*",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/types": "^1.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "better-auth": "^1.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "expo": "~55.0.4",
    "expo-audio": "55.0.6",
    "expo-background-task": "^55.0.9",
    "expo-build-properties": "^55.0.9",
    "expo-camera": "^55.0.9",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "^55.0.7",
    "expo-dev-client": "^55.0.11",
    "expo-device": "^55.0.9",
    "expo-document-picker": "^55.0.8",
    "expo-file-system": "^55.0.10",
    "expo-font": "^55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image-picker": "^55.0.10",
    "expo-linear-gradient": "^55.0.8",
    "expo-linking": "^55.0.7",
    "expo-navigation-bar": "^55.0.8",
    "expo-network": "^55.0.8",
    "expo-notifications": "^55.0.10",
    "expo-router": "~55.0.4",
    "expo-secure-store": "^55.0.8",
    "expo-sharing": "^55.0.11",
    "expo-splash-screen": "^55.0.10",
    "expo-sqlite": "^55.0.10",
    "expo-status-bar": "^55.0.4",
    "expo-system-ui": "^55.0.9",
    "expo-task-manager": "^55.0.9",
    "expo-updates": "^55.0.12",
    "expo-web-browser": "^55.0.9",
    "lucide-react-native": "^0.562.0",
    "nativewind": "5.0.0-preview.2",
    "pawnote": "^1.6.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.83.2",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.2.0",
    "react-native-purchases": "^9.7.3",
    "react-native-purchases-ui": "^9.7.3",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "catalog:",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.3.3",
    "@types/react": "catalog:",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~55.0.10",
    "eslint": "^9.39.2",
    "jest-expo": "^55.0.9",
    "postcss": "^8.5.6",
    "typescript": "catalog:"
  }
}
