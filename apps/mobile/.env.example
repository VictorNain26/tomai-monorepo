# API URL
# Staging: https://api-staging.tomia.fr
# Production: https://api.tomia.fr
EXPO_PUBLIC_API_URL=https://api-staging.tomia.fr

# Google OAuth (required for Google Sign-In)
# Web client ID from Google Cloud Console (NOT Android/iOS client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat API Key (required for in-app purchases)
# Get your key from https://app.revenuecat.com/
EXPO_PUBLIC_REVENUECAT_API_KEY=
