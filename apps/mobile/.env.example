# =============================================================================
# tom-mobile (Expo) — variables d'environnement
# Copier vers apps/mobile/.env (gitignoré) et remplir.
#
# Deux familles, à ne pas confondre :
#   EXPO_PUBLIC_*  → inlinées dans le bundle par Expo, donc VISIBLES par
#                    n'importe qui décompilant l'app. Jamais de secret ici.
#   sans préfixe   → lues au moment du build (app.config.ts) uniquement.
# =============================================================================

# EXPO_PUBLIC_API_URL — [dev] NE PAS définir en dev local : l'app dérive l'URL
# du backend depuis l'IP Metro (hostUri) — device physique → IP LAN,
# émulateur Android → 10.0.2.2. Ne définir que pour forcer un backend distant.
# EXPO_PUBLIC_API_URL=https://api.tomia.fr

# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID — [externe] connexion Google.
# Client ID **Web** de la Google Cloud Console (surtout PAS l'Android/iOS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EXPO_PUBLIC_REVENUECAT_API_KEY — [externe] achats in-app.
# Clé publique SDK, https://app.revenuecat.com/. Mobile natif uniquement.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# EXPO_PUBLIC_SENTRY_DSN — [externe] optionnel. Absent = Sentry.init est un
# no-op strict. À poser via les secrets EAS pour les builds preview/production,
# jamais en dev local.
# EXPO_PUBLIC_SENTRY_DSN=

# EXPO_PUBLIC_E2E — [dev] `1` active les stubs Pronote de l'onboarding
# (src/services/pronote/pronote-e2e-stubs.ts), pour les parcours Maestro en
# build preview. Toute autre valeur, ou absente, désactive les stubs — c'est
# le défaut de production et il ne faut pas le changer.
# EXPO_PUBLIC_E2E=1

# APP_ENV — [dev] lue par app.config.ts au BUILD, pas inlinée dans le bundle
# (elle n'a pas le préfixe EXPO_PUBLIC_, donc Expo ne l'embarque pas).
# Défaut `development`. `production` bascule la configuration applicative.
# APP_ENV=development
