{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "APP_ENV"
  ],
  "globalPassThroughEnv": [
    "GITHUB_ACTIONS",
    "VERCEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production",
        ".env.staging",
        "!.env.local",
        "!.env.*.local"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:ios": {
      "cache": false,
      "persistent": true
    },
    "dev:android": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "jest.config.*",
        "__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "CI"],
      "passThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET"]
    }
  }
}
