{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    // bun-types: les types Eden Treaty re-exportés depuis `tomai-server/app`
    // (workspace dep) tirent des fichiers source qui référencent le global Bun.
    // Type-only, aucun impact runtime sur les consommateurs du package.
    "types": ["bun-types"],
    "paths": {
      "@repo/shared-types": ["../shared-types/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
