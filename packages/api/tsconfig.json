{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for fetch/Request/Response types used by the Eden client. No bun-types:
    // the `App` type comes from the server's *built* declarations
    // (tomai-server/app -> dist/types/app.d.ts), which carry no Bun globals.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
