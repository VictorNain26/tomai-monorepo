{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    // No bun-types: the `App` type now comes from the server's *built*
    // declarations (tomai-server/app -> dist/types/app.d.ts), which carry no
    // Bun globals. Pulling bun-types here would re-admit the leak we removed.
    "paths": {
      "@repo/shared-types": ["../shared-types/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
